<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Activity uses Theme.uTV.Splash via the splash screen API -->
    <style name="Theme.uTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash theme — installs the native splash screen before Compose takes over -->
    <style name="Theme.uTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.uTV</item>
    </style>
</resources>
